model Model
	culture: en-US
	discourageImplicitMeasures
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-GB
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["investigation_cases", "model_performance_log"]
annotation PBI_ETD_Report = pbi_regulatory_compliance
