		lineageTag: bff25e74-a268-5c60-8b90-08cc08af0bab

	measure AverageRiskScore = AVERAGE(anomaly_scores[composite_risk_score])
		formatString: 0.000
		lineageTag: 2efaee62-abae-5b1a-a435-e28bd6e4ec69

	partition anomaly_scores = m
		mode: directQuery
		source =
