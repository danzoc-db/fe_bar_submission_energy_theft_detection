# Local developer overrides — copy to .env.local (gitignored).
# Values here take precedence over .env.
#
# Fill in your workspace-specific credentials to connect to live Databricks
# resources during local development. Leave blank to run in offline mode
# with hardcoded default data.

# Databricks CLI profile (must exist in ~/.databrickscfg)
DATABRICKS_CONFIG_PROFILE=DEFAULT

# SQL Warehouse ID — find in your workspace under SQL > SQL Warehouses
SQL_WAREHOUSE_ID=

# AI Gateway endpoint name for the Bedrock LLM
AI_GATEWAY_ENDPOINT=energy-theft-bedrock-gateway

# Gemini Gateway endpoint name
GEMINI_GATEWAY_ENDPOINT=energy-theft-gemini-gateway

# MAS (Multi-Agent Supervisor) endpoint name
MAS_ENDPOINT=

# Genie Space ID — find in the Genie Space URL (/genie/rooms/<id>)
GENIE_SPACE_ID=

# Unity Catalog catalog name for this workspace
CATALOG=

# Schema name (usually the same across workspaces)
SCHEMA_NAME=energy_theft_protection

# --- Lakebase (operational serving) ---------------------------------------
# Set to true once the Lakebase instance is provisioned
# (see scripts/provision_lakebase.py). When false/unset, the app runs the
# Delta-only path and all Lakebase calls fall back gracefully.
LAKEBASE_ENABLED=false
LAKEBASE_INSTANCE_NAME=energy-theft-lakebase
LAKEBASE_DATABASE=databricks_postgres
LAKEBASE_SCHEMA=revenue_protection
LAKEBASE_SERVING_TABLE=anomaly_scores_serving
